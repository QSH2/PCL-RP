<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <AssemblyName>pcl-ce-regionpatch</AssemblyName>
        <RootNamespace>PclCeRegionPatch</RootNamespace>
        <Version>1.2.3</Version>
        <Authors>PCL-CE-RegionPatch contributors</Authors>
        <Description>Command-line patcher that removes the mainland-China region gate from a user-owned official PCL CE single-file build.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\PclCeRegionPatch.Core\PclCeRegionPatch.Core.csproj" />
    </ItemGroup>

</Project>
