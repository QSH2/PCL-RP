<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <RootNamespace>PclCeRegionPatch</RootNamespace>
        <AssemblyName>PclCeRegionPatch.Core</AssemblyName>
        <Version>1.1.0</Version>
        <Authors>PCL-CE-RegionPatch contributors</Authors>
        <Description>Core library: locates the embedded PCL CE main assembly and patches the region-restriction methods.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    </ItemGroup>

</Project>
